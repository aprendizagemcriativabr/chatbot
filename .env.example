VERIFY_TOKEN=
APP_SECRET=
ADMIN_TOKEN=
PHONE_NUMBER_ID=
ACCESS_TOKEN=
PORT=
NODE_ENV=

# Persistence provider: sqlserver (default) | sqlite
DB_PROVIDER=sqlserver

# Azure SQL Database (required when DB_PROVIDER=sqlserver)
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# SQLite (required when DB_PROVIDER=sqlite)
SQLITE_FILE_PATH=./data/sqlite.db

# Google APIs (Sheets/Drive)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
